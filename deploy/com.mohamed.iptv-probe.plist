<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mohamed.iptv-probe</string>
  <!-- Nightly feed-quality probe from this Mac (the provider refuses streams from the box).
       A run missed while the Mac slept happens on wake; it stops as soon as the one
       connection slot is in use. Install (README "Feed quality"):
       cp deploy/com.mohamed.iptv-probe.plist ~/Library/LaunchAgents/ &&
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.mohamed.iptv-probe.plist -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>deploy/probe-quality.sh</string>
    <string>30</string>
  </array>
  <key>WorkingDirectory</key>
  <string>~/personal/iptv-preview</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>~/Library/Logs/iptv-probe.log</string>
  <key>StandardErrorPath</key>
  <string>~/Library/Logs/iptv-probe.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SERVER</key>
    <string>root@<server-ip></string>
    <key>PATH</key>
    <string>~/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
