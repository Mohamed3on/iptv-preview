# Every setting the server and its jobs read. On the server: /opt/sofa/.env.
# Locally: .env.local (bun --env-file=.env.local …). Only the first block is required.

# --- Required -----------------------------------------------------------------
# Your Xtream Codes provider: the panel's address (scheme and port, no trailing slash) and account.
XTREAM_HOST=http://provider.example:8080
XTREAM_USER=
XTREAM_PASS=
# Any long random string (openssl rand -hex 24). Gates /api/playlist?t=… and /api/epg?t=….
PLAYLIST_TOKEN=
# Tokens the Fire TV app may use, comma-separated (one per build; two while rotating). Never PLAYLIST_TOKEN.
APP_TOKENS=

# --- Channels -----------------------------------------------------------------
# The built-in channel choices are one person's tastes (UK/EU/Arabic football, tennis, UFC): pick
# your own. See "Channels: choose your own" in docs/SETUP.md for the rules to edit in api/_lib.ts.
# More provider categories to list, as a case-insensitive regex over their names; each becomes its
# own group.
# EXTRA_CATEGORIES=^US\| NBA|^UK\| CRICKET
# XMLTV guides, comma-separated, best first. Unset: the provider's own guide.
# EPG_URLS=https://epg.example/guide.xml.gz
# A second provider whose feeds become spares for the same channels.
# XTREAM2_HOST=
# XTREAM2_USER=
# XTREAM2_PASS=
# XTREAM2_VPN_HOST=

# --- Movies & Shows (Fire TV app) ---------------------------------------------
# TMDB API read access token (or v3 key). Without it the library is only the provider's own groups.
# TMDB_TOKEN=
# IMDb and Letterboxd scores on titles (mdblist.com API key).
# MDBLIST_KEY=
# Debrid accounts for films and episodes the provider lacks; the app plays the best copy from either.
# REAL_DEBRID_TOKEN=
# TORBOX_TOKEN=
# Trakt sync (create an app at trakt.tv/oauth/applications; sign in from the app's Options).
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# Your Letterboxd username: its diary marks films watched.
# LETTERBOXD_USER=
# The store of a TrueScore (github.com/Mohamed3on/truescore) running on this server (letterboxd.json). Missing file: its two rows don't show, everything else works.
# LETTERBOXD_HISTOGRAMS=/var/lib/truescore/letterboxd.json
# OpenSubtitles account, tried after the free OpenSubtitles addon.
# OPENSUBTITLES_KEY=
# OPENSUBTITLES_USER=
# OPENSUBTITLES_PASS=

# --- Offline jobs ---------------------------------------------------------------
# TypeSafe (typesafe.ai) key: the competition learner and guide matcher ask Jev where rules fall short.
# TYPESAFE_API_KEY=

# --- Overrides (defaults are fine) --------------------------------------------
# PORT=8790
# EPG_ENDPOINT=http://127.0.0.1:8790/api/epg
# API_BASE=http://127.0.0.1:8790/api
# APP_DIR=/opt/sofa/app
