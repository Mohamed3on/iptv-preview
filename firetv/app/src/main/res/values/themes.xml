<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is ink from the first frame, so a cold start never flashes the system
         default before Compose draws. -->
    <style name="Theme.Iptv" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
    </style>
</resources>
