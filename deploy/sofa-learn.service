[Unit]
Description=sofa: learn which channels carry which competition from the EPG
After=sofa.service
Wants=sofa.service

[Service]
Type=oneshot
User=sofa
WorkingDirectory=/opt/sofa
EnvironmentFile=/opt/sofa/.env
Environment=EPG_ENDPOINT=http://127.0.0.1:8790/api/epg
# Writes .cache/competitions.json, which the server reads again on its own.
ExecStart=/usr/local/bin/bun scripts/learn-competitions.ts
