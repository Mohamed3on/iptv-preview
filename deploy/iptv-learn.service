[Unit]
Description=iptv-preview: learn which channels carry which competition from the EPG
After=iptv-preview.service
Wants=iptv-preview.service

[Service]
Type=oneshot
User=iptv
WorkingDirectory=/opt/iptv-preview
EnvironmentFile=/opt/iptv-preview/.env
Environment=EPG_ENDPOINT=http://127.0.0.1:8790/api/epg
ExecStartPre=/bin/cp api/competition-cache.ts /tmp/iptv-competition-cache.ts
ExecStart=/usr/local/bin/bun scripts/learn-competitions.ts
# The server reads the cache at startup, so restart it when the learner changed it.
ExecStartPost=+/bin/sh -c 'cmp -s /tmp/iptv-competition-cache.ts /opt/iptv-preview/api/competition-cache.ts || systemctl restart iptv-preview'
